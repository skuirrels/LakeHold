{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Lakehouse": {
    "SnapshotRetention": "7.00:00:00"
  },
  "Lakehold": {
    "Maintenance": {
      "Enabled": true,
      "FlushCron": "0 0/15 * * * ?",
      "BackupCron": "0 0 * * * ?",
      "CompactCron": "0 30 2 * * ?"
    },
    "Cdc": {
      "Enabled": true,
      "PollInterval": "00:00:15",
      "MaxChangesPerTable": 1000,
      "MaxSnapshotsPerSubscriptionPerSweep": 100,
      "MaxConcurrentSubscriptions": 4,
      "DeliveryTimeout": "00:00:30",
      "LeaseDuration": "00:01:00",
      "MaxBackoff": "00:30:00"
    },
    "Connectors": {
      "Enabled": true,
      "PollInterval": "00:00:15",
      "LeaseDuration": "00:05:00",
      "RequestTimeout": "00:02:00",
      "MaxConcurrentRuns": 2,
      "MaxSnapshotBytes": 536870912,
      "MaxRows": 1000000,
      "MaxPaginationPages": 10000,
      "MaxHubSpotResultsPerWindow": 9000,
      "HubSpotIndexingDelay": "00:05:00",
      "HubSpotCheckpointOverlap": "00:15:00",
      "HubSpotMinimumRequestInterval": "00:00:00.250",
      "MaxRecordBytes": 16777216,
      "MaxAggregateScratchBytes": 1073741824,
      "MinimumFreeBytes": 1073741824,
      "StaleFileAge": "1.00:00:00",
      "ScratchRoot": "",
      "AllowHttp": false,
      "AllowUnsafeDestinations": false,
      "AllowedHosts": [],
      "SecretProviderEndpoint": "",
      "SecretProviderTokenEnvironmentVariable": "LAKEHOLD_CONNECTOR_VAULT_TOKEN",
      "SecretBindings": []
    },
    "Mcp": {
      "Enabled": false,
      "Route": "/mcp",
      "PublicBaseUrl": "",
      "AllowWrites": false,
      "MaxRowsPerResult": 200
    },
    "Oidc": {
      "Authority": "",
      "Audience": "",
      "ClientId": "",
      "RequireHttpsMetadata": true,
      "TenantClaim": "tenant",
      "RoleClaim": "role",
      "SystemAdminClaim": "lakehold_admin",
      "SystemAdminValue": "true",
      "Scopes": []
    },
    "CsvImport": {
      "MaxBytes": 5368709120,
      "MaxAggregateScratchBytes": 5368709120,
      "MaxConcurrentUploads": 2,
      "MinimumFreeBytes": 1073741824,
      "ScratchRoot": "",
      "StaleFileAge": "1.00:00:00"
    },
    "PgWire": {
      "Enabled": false,
      "Port": 5433,
      "MaxRows": 0,
      "AllowCleartextPassword": false,
      "AllowAnonymous": false,
      "MaxConnections": 64,
      "HandshakeTimeout": "00:00:15",
      "IdleTimeout": "00:30:00",
      "MaxMessageBytes": 16777216,
      "TlsCertificatePath": "",
      "TlsCertificateKeyPath": "",
      "RequireTls": false
    }
  }
}
