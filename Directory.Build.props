<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      The product version, carried into every assembly so a running process can report what it is.
      The MCP server advertises it as its `serverInfo.version` during the initialization handshake,
      where clients log it and use it for compatibility checks. Left at the SDK default this reported
      1.0.0 on a 2.3.x release, which is worse than reporting nothing.

      Keep this in step with the release tag. A release build may override it with
      `-p:Version=<tag>` without editing the file.
    -->
    <Version>2.5.0</Version>
    <Product>Lakehold</Product>
    <Company>Lakehold</Company>
    <Authors>Lakehold contributors</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
