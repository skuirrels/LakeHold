<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lakehouse engine + control plane persistence.

         The ADO.NET layer is the Skuirrels fork of DuckDB.NET, which is what DuckDB.EFCoreProvider
         1.27.0 and later depend on. Package 1.5.6 carries DuckDB engine v1.5.6 — the two version
         lines are separate, so verify the engine version with `SELECT version()`, not by deriving
         it from the package version. Skuirrels.DuckDB.NET 2.0.0 exists, but it is the DuckDB 2
         engine line and the provider has not moved to it; stay on 1.5.x until it does.

         These are pinned explicitly even though no project references them directly. Transitive
         pinning is enabled, so this is what fixes the native engine version rather than leaving it
         to whatever the provider happens to resolve. The upstream `DuckDB.NET.*` packages are
         deliberately absent: the provider no longer uses them, and a pin on an unreferenced package
         id silently constrains nothing while still reading like a guarantee.

         EF Core stays on the 10.0 line although the backend targets net11.0. The control plane
         runs on Npgsql.EntityFrameworkCore.PostgreSQL, whose newest stable release (10.0.3)
         requires EF Core [10.0.4, 11.0.0); its only EF Core 11 build is 11.0.0-rc.3, which pins an
         EF Core 11 release candidate exactly. A release candidate under the production control
         plane is not an acceptable trade for a version number, so every EF Core package, the
         EF10 line of DuckDB.EFCoreProvider (which the provider documents as running on .NET 11),
         and DataProtection's EF Core store below hold at 10.0.x until Npgsql publishes a stable 11.
         Move them together: one EF Core major per process. -->
    <PackageVersion Include="Confluent.Kafka" Version="2.16.0" />
    <PackageVersion Include="Confluent.SchemaRegistry.Serdes.Avro" Version="2.16.0" />
    <PackageVersion Include="Skuirrels.DuckDB.NET.Data.Full" Version="1.5.6" />
    <PackageVersion Include="Skuirrels.DuckDB.NET.Bindings.Full" Version="1.5.6" />
    <PackageVersion Include="DuckDB.EFCoreProvider" Version="1.31.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Aspire orchestration -->
    <!-- 13.4.6 carries GHSA-f7vh-h5g3-7jrh (high) and its dashboard SDK GHSA-4g86-54fm-h9h8
         (critical); NuGet audit fails the build on both. -->
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.6.5" />
    <!-- Node/npm hosting moved out of Aspire.Hosting.NodeJs (frozen at 9.5.2) in Aspire 13. -->
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.6.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Service defaults: telemetry, health, resilience -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="11.0.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <!-- The EF Core instrumentation has only ever shipped as a prerelease; 1.21.0-beta.1 is the
         current build of the same 1.21.0 line as the stable instrumentation packages above. -->
    <PackageVersion Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.21.0-beta.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- API surface -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <!-- Microsoft.AspNetCore.OpenApi 11.0.0 requires Microsoft.OpenApi [3.11.0, 4.0.0). The pin also
         keeps the graph above 2.0.0, which carries GHSA-v5pm-xwqc-g5wc (high). Transitive pinning is
         enabled, so this reaches the restore graph. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="3.11.0" />
    <!-- OIDC for bearer clients and the Workbench authorization-code session. Lakehold remains a
         relying party/resource server, never an identity provider. -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="11.0.0" />
    <!-- 10.0.x, not 11.0.0: 11.0.0 requires EF Core 11. See the EF Core note above. -->
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.15" />
    <!-- Neither is referenced directly; both reach the graph transitively. The 10.0.10 builds carry
         GHSA-846f-f764-76mx and GHSA-2fmv-rv2c-59x7 (Pkcs) and GHSA-7hqp-7c5m-4vq6,
         GHSA-c399-9853-6jmj, and GHSA-r955-8q5j-3h83 (Xml), and NuGet audit fails the build on them.
         Pinned to the release matching the target framework so the transitive default cannot fall
         back below those fixes. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="11.0.0" />
    <!--
      SDK 2.x tracks MCP revision 2026-07-28; 1.4.x tracks the superseded one, so shipping against
      1.4.x would mean rewriting immediately. Held at 2.0.0-rc.1 for that reason until the stable
      2.0.0 published, then advanced to 2.2.0 on 15 August 2026 and 2.4.0 on 15 November 2026. Do
      not go back to 1.4.x. See docs/MCP.md.
    -->
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
    <!-- Managed connector gRPC contract and streaming client. Stable package lines verified from
         NuGet; Grpc.Tools is build-only and does not ship in the API image. -->
    <PackageVersion Include="Google.Protobuf" Version="3.36.2" />
    <PackageVersion Include="Grpc.Core.Api" Version="2.85.0" />
    <PackageVersion Include="Grpc.AspNetCore" Version="2.85.0" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.85.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.85.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Local development configuration. Loads .env into the process environment before the host
         reads configuration, so compose credentials and the integration-test gates live in one
         gitignored file rather than in each developer's shell profile. Development only: real
         deployments use the platform's own environment or secret store. -->
    <PackageVersion Include="DotNetEnv" Version="3.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared extensions -->
    <!-- Keep Roslyn on one release line. EF Core Design permits Workspaces 5.0.0 or newer, but
         NuGet otherwise selects the minimum while the Roslyn packages constrain one another to an
         exact version. Pin the three roots together so the transitive Common, Workspaces.Common,
         and MSBuild.Contracts packages all resolve consistently. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.12.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test-only -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <!-- Held on 3.x: 4.0 is a new major line. Move it with a deliberate xunit v3 migration, not as a
         side effect of a framework retarget. -->
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- xunit 2.x cannot skip a test at run time, and the backup integration tests need a real
         PostgreSQL or S3 endpoint. Without dynamic skip they would either fail on a machine with no
         Docker or pass silently having asserted nothing — both worse than reporting "skipped". -->
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.85" />
    <!-- The PostgreSQL wire endpoint is tested through Npgsql rather than a hand-rolled client:
         Power BI's PostgreSQL connector is built on it, so this exercises the message sequence a
         real BI tool sends rather than the one we assumed it would. -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Scheduling. Held on 3.x: Quartz 4 is a new major line with its own migration. -->
    <PackageVersion Include="Quartz.Extensions.Hosting" Version="3.19.1" />
  </ItemGroup>

</Project>
